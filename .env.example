# Clé secrète Flask (sessions/cookies). A régénérer en production.
SECRET_KEY=change-this-secret-key

# Identifiants du premier compte admin créé automatiquement au démarrage.
# A changer immédiatement en production (page "Équipe Admin").
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Note : les bases MongoDB des clients (une par client Pro-Avif) ne se configurent PAS ici.
# Elles s'ajoutent depuis l'interface web, page "Tableau de bord" (nom + URI de connexion
# + nom de la base), et sont stockées dans instance/admin.db (SQLite, jamais commité).
